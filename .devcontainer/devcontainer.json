{
  "name": "FinRL-X",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt && pip install -e .",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "FinRL Trading Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "bash -lc 'PYTHONPATH=src streamlit run src/web/app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true >/tmp/finrl-streamlit.log 2>&1 &'"
}
